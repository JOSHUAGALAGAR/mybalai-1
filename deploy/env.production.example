# Copy to deploy/.env.production (ignored by git) and fill in. Uploaded to the server as
# shared/.env.production.local — Next.js reads it when building and starting.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of the site (baked into the build, used for payment return links)
NEXT_PUBLIC_SITE_URL=https://mybalai.delxtdev.cloud

# PayMongo. sk_live_ = REAL money. The webhook secret belongs to a webhook pointing at
# https://mybalai.delxtdev.cloud/api/paymongo/webhook
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=card,qrph
