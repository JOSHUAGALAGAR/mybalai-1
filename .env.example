# MyBalai v3 — environment template. Copy to .env.local and fill in real values.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret (service-role) key — SERVER ONLY. Bypasses Row Level Security.
# Must never appear in client bundles or be sent to third parties.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public site origin (used for metadata / OG URLs, and PayMongo redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PayMongo (optional) ---------------------------------------------------
# Leave blank to keep payments/subscriptions on the manual flow only.
# Test keys from https://dashboard.paymongo.com/developers (start with sk_test_).
# SERVER ONLY. Never expose the secret key or webhook secret to the browser.
PAYMONGO_SECRET_KEY=
# Signing secret shown once when you create the webhook (whsec_...).
PAYMONGO_WEBHOOK_SECRET=
# Optional. Comma-separated checkout methods (default: card). Only list ones you
# have ENABLED in the PayMongo dashboard (Settings -> Payment Methods) or every
# checkout fails with "X is not enabled". `qrph` = QR Ph (the on-page QR code).
# PAYMONGO_METHODS=card,gcash,paymaya,grab_pay,qrph
